<sdf version='1.9'>
  <!-- Thunder collapse world (stock baylands.sdf is unchanged).
       No intruder NPCs — those belong to the intercept sim on baylands.
       Park mesh stays at stock baylands (near origin) so scene/info comes up.
       Collapse boxes sit 10 km west of the origin catapult. Do not move the
       Fuel mesh — 50 km terrain offset blocked SceneBroadcaster.
       Spawn: PX4_GZ_MODEL_POSE 0,-1,0.79 pitch -12° (Gazebo nose-up) yaw west. -->
  <world name='baylands_thunder'>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.8 0.5 1</ambient>
      <grid>false</grid>
      <sky>
        <clouds>true</clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/baylands
      </uri>
      <name>park</name>
      <pose>205.000 155 -1 0 0 0</pose>
    </include>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water
      </uri>
      <pose>0 0 -2 0 0 0
        <relative_to>park</relative_to>
      </pose>
    </include>

    <!-- Floor under the 1 m collapse stack (10 km west of spawn). -->
    <model name="box_stack_pad">
      <static>true</static>
      <pose>-10002.000 -1 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 5 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.45 0.45 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3x3 x 8 dynamic 1 m cubes. -->
    <include>
      <uri>model://collapse_box</uri>
      <name>box_0_0_0</name>
      <pose>-10003.020 -2.020 0.510 0 0 0</pose>
    </include>
    <include>
      <uri>model://collapse_box</uri>
      <name>box_1_0_0</name>
      <pose>-10002.000 -2.020 0.510 0 0 0</pose>
    </include>
    <include>
      <uri>model://collapse_box</uri>
      <name>box_2_0_0</name>
      <pose>-10000.980 -2.020 0.510 0 0 0</pose>
    </include>
