    <!-- Pneumatic UAV launcher (Robonic MC2555-class): ~10 m stroke, 12°
         (envelope 8–15°), exit 1.2× stall. Cradle stays at the origin. -->
    <model name="catapult_launcher">
      <static>true</static>
      <pose>-4.18 -1 1.41 0 -0.2094 3.14159</pose>
      <link name="rail">
        <collision name="collision">
          <geometry>
            <box>
              <size>11.0 1.2 0.20</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.60</mu>
                <mu2>0.60</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>11.0 1.2 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.28 0.32 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="catapult_chock">
      <!-- Downhill stop. 12° and mu&lt;tan(12°) still holds 85 kg on the pad. -->
      <static>true</static>
      <pose>1.14 -1 0.48 0 -0.2094 3.14159</pose>
      <link name="block">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 1.00 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 1.00 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.22 0.12 1</ambient>
            <diffuse>0.55 0.28 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="catapult_cradle">
      <static>true</static>
      <pose>0.40 -1 0.48 0 -0.2094 3.14159</pose>
      <link name="pad">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.60 0.90 0.12</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.60</mu>
                <mu2>0.60</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.60 0.90 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.28 1</ambient>
            <diffuse>0.32 0.34 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="catapult_base">
      <static>true</static>
      <pose>0.80 -1 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.60 1.00 0.56</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
