          <cone>
            <length>0.18</length>
            <radius>0.055</radius>
          </cone>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1.0</ambient>
          <diffuse>0.2 0.2 0.22 1.0</diffuse>
        </material>
      </visual>
