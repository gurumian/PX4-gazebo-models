<?xml version="1.0"?>
<sdf version='1.10'>
  <model name='rocket_quadtailsitter2'>
    <link name='base_link'>
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>1.4</mass>
        <inertia>
          <!-- Slender rocket body with vertical delta fins on sides -->
          <ixx>0.065</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.065</iyy>
          <iyz>0</iyz>
          <izz>0.012</izz>
        </inertia>
      </inertial>
      <collision name='fuselage_collision'>
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.9</length>
            <radius>0.055</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
          <friction>
            <ode />
