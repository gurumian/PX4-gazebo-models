<?xml version="1.0"?>
<sdf version="1.9">
  <model name="collapse_box">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <!-- cube I = m * s^2 / 6 -->
          <ixx>0.333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.333333</iyy>
          <iyz>0</iyz>
          <izz>0.333333</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.05</restitution_coefficient>
          </bounce>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.38 0.12 1</ambient>
          <diffuse>0.85 0.48 0.16 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
