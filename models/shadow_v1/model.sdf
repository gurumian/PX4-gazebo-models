<?xml version="1.0"?>
<sdf version='1.10'>
  <model name='shadow_v1'>
    <link name='base_link'>
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <!-- FCU / battery (printed fuselage is in oml_body link) -->
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <include merge="true">
      <uri>model://airspeed</uri>
      <pose>0 0 0.7 0 -1.57 0</pose>
    </include>
    <joint name='airspeed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>airspeed_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <!-- PETG-CF fuselage OML (OML_NO_WING.dae: hub/body only, no wing panels). -->
    <!-- Pose: motor plane (mesh z=0) at base_link z=0.32, +45 deg aligned with X-wing rotors. -->
    <link name='oml_body'>
      <pose>0 0 0.32 0 0 0.7853981633974483</pose>
      <inertial>
        <pose>0 0 0.042 0 0 0</pose>
        <mass>2.440</mass>
        <inertia>
          <ixx>0.075243</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.075243</iyy>
          <iyz>0</iyz>
          <izz>0.078741</izz>
        </inertia>
      </inertial>
      <collision name='oml_body_collision'>
        <geometry>
          <mesh>
            <uri>model://shadow_v1/meshes/OML_NO_WING.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='oml_body_visual'>
        <geometry>
          <mesh>
            <uri>model://shadow_v1/meshes/OML_NO_WING.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.68 0.71 0.74 1.0</ambient>
          <diffuse>0.68 0.71 0.74 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='oml_body_joint' type='fixed'>
      <parent>base_link</parent>
      <child>oml_body</child>
    </joint>

    <!-- Tail cruciform fins: chord 2/3 vs nowing7 (0.085×0.147 m), offset 0.07 m, z=0.32. -->
    <link name='tail_wing'>
      <pose>0 0 0.32 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.04</mass>
        <inertia>
          <ixx>0.00037</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00037</iyy>
          <iyz>0</iyz>
          <izz>0.00067</izz>
        </inertia>
      </inertial>
      <collision name='tail_wing_pos_y_collision'>
        <pose>0 0.07 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
      </collision>
      <collision name='tail_wing_pos_x_collision'>
        <pose>0.07 0 0 0 0 -1.5707963267948966</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
      </collision>
      <collision name='tail_wing_neg_y_collision'>
        <pose>0 -0.07 0 0 0 3.141592653589793</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
      </collision>
      <collision name='tail_wing_neg_x_collision'>
        <pose>-0.07 0 0 0 0 1.5707963267948966</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
      </collision>
      <visual name='tail_wing_pos_y_visual'>
        <pose>0 0.07 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='tail_wing_pos_x_visual'>
        <pose>0.07 0 0 0 0 -1.5707963267948966</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='tail_wing_neg_y_visual'>
        <pose>0 -0.07 0 0 0 3.141592653589793</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='tail_wing_neg_x_visual'>
        <pose>-0.07 0 0 0 0 1.5707963267948966</pose>
        <geometry>
          <box>
            <size>0.006 0.085 0.146667</size>
          </box>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='tail_wing_joint' type='fixed'>
      <parent>base_link</parent>
      <child>tail_wing</child>
    </joint>

    <!-- PETG-CF motor arms: OD 10 mm, span 170 mm (body OD 11 mm → wing tip).
         ρ≈1.40 g/cm³ solid proxy → ~12 g/arm, 48 g total. -->
    <link name='arm_ne'>
      <pose>0.099 0.099 0.32 0 1.5707963267948966 0.7853981633974483</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>1.5e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.91e-05</iyy>
          <iyz>0</iyz>
          <izz>2.91e-05</izz>
        </inertia>
      </inertial>
      <collision name='arm_ne_collision'>
