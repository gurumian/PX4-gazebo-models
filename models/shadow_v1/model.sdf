    <!-- No wing panels: fuselage drag/lift proxy only (OML fins removed). -->
    <plugin filename="gz-sim-advanced-lift-drag-system" name="gz::sim::systems::AdvancedLiftDrag">
      <a0>0.0</a0>
      <CL0>0.0</CL0>
      <AR>3.0</AR>
      <eff>0.90</eff>
      <CLa>3.0</CLa>
      <cda>1.5</cda>
      <CD0>0.25</CD0>
      <Cem0>0.0</Cem0>
      <Cema>-0.2</Cema>
      <CYb>-0.1</CYb>
      <Cellb>-0.02</Cellb>
      <Cenb>0.05</Cenb>
      <CDp>0.0</CDp>
      <CYp>0.03</CYp>
      <CLp>0.0</CLp>
