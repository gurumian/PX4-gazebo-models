<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='ground_radar_station'>
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Tower base -->
    <link name='base_link'>
      <pose>0 0 2.5 0 0 0</pose>
      <collision name='tower_collision'>
        <geometry>
          <cylinder>
            <radius>0.4</radius>
            <length>5.0</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name='tower_visual'>
        <geometry>
          <cylinder>
            <radius>0.4</radius>
            <length>5.0</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.35 0.35 0.38 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Radar head (visual only; targets come from radar_sim truth stub) -->
    <link name='radar_link'>
      <pose>0 0 5.2 0 0 0</pose>
      <visual name='radar_head_visual'>
        <geometry>
          <box>
            <size>0.6 0.6 0.4</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.15 0.2 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name='radar_mount_joint' type='fixed'>
      <parent>base_link</parent>
      <child>radar_link</child>
      <pose>0 0 2.7 0 0 0</pose>
    </joint>
  </model>
</sdf>
