<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='intruder_quadtailsitter'>
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name='base_link'>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.04</izz>
        </inertia>
      </inertial>

      <visual name='body_visual'>
        <pose>-0.005 0 0.4 0 0 1.57</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://quadtailsitter/meshes/body.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.45 0.12 0.12 1.0</ambient>
          <diffuse>0.55 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <collision name='body_collision'>
        <!-- FW: pitched 90 deg; long axis along nose (+Z body → horizontal flight). -->
        <pose>0 0 0 0 1.5707 0</pose>
        <geometry>
          <box>
            <size>0.55 0.35 0.25</size>
          </box>
        </geometry>
      </collision>

      <!-- Large visual + collision so gpu_lidar can see the intruder at range. -->
      <visual name='radar_reflector_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.0 3.0 1.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 0.35</ambient>
          <diffuse>0.9 0.15 0.15 0.35</diffuse>
        </material>
        <transparency>0.65</transparency>
      </visual>
      <collision name='radar_reflector'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.0 3.0 1.5</size>
          </box>
        </geometry>
      </collision>
    </link>

    <plugin filename="libTrajectoryFollowerController.so"
            name="custom::TrajectoryFollowerController">
      <link_name>base_link</link_name>
      <loop>true</loop>
      <!-- Kinematic: SetWorldPoseCmd each step (no ODE wrench). Pose pub throttled for radar. -->
      <kinematic>true</kinematic>
      <publish_pose>true</publish_pose>
      <pose_publish_rate_hz>25</pose_publish_rate_hz>
      <pose_topic>/intruder/pose</pose_topic>
      <!-- Tailsitter FW cruise: nose (+Z body) horizontal; applied after waypoint yaw. -->
      <pitch_offset>1.5707</pitch_offset>
      <!-- Large ellipse patrol a=250 m, b=150 m, ~100 km/h; relative to spawn pose. -->
      <waypoint><time>0.000</time><pose>250.00 0.00 0.00 0.000 0.000 1.571</pose></waypoint>
      <waypoint><time>0.709</time><pose>247.86 19.58 0.00 0.000 0.000 1.787</pose></waypoint>
      <waypoint><time>1.439</time><pose>241.48 38.82 0.00 0.000 0.000 1.991</pose></waypoint>
      <waypoint><time>2.207</time><pose>230.97 57.40 0.00 0.000 0.000 2.175</pose></waypoint>
      <waypoint><time>3.027</time><pose>216.51 75.00 0.00 0.000 0.000 2.337</pose></waypoint>
      <waypoint><time>3.906</time><pose>198.34 91.31 0.00 0.000 0.000 2.478</pose></waypoint>
      <waypoint><time>4.847</time><pose>176.78 106.07 0.00 0.000 0.000 2.601</pose></waypoint>
      <waypoint><time>5.847</time><pose>152.19 119.00 0.00 0.000 0.000 2.710</pose></waypoint>
