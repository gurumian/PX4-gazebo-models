      <waypoint><time>44.477</time><pose>241.48 -38.82 0.00 0.000 0.000 1.151</pose></waypoint>
      <waypoint><time>45.207</time><pose>247.86 -19.58 0.00 0.000 0.000 1.355</pose></waypoint>
      <waypoint><time>45.916</time><pose>250.00 -0.00 0.00 0.000 0.000 1.571</pose></waypoint>
    </plugin>
  </model>
