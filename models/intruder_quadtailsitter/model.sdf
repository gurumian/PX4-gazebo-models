      <waypoint><time>8.003</time><pose>95.67 138.58 0.00 0.000 0.000 2.898</pose></waypoint>
      <waypoint><time>9.140</time><pose>64.70 144.89 0.00 0.000 0.000 2.982</pose></waypoint>
      <waypoint><time>10.303</time><pose>32.63 148.72 0.00 0.000 0.000 3.063</pose></waypoint>
      <waypoint><time>11.479</time><pose>0.00 150.00 0.00 0.000 0.000 3.142</pose></waypoint>
      <waypoint><time>12.655</time><pose>-32.63 148.72 0.00 0.000 0.000 -3.063</pose></waypoint>
      <waypoint><time>13.817</time><pose>-64.70 144.89 0.00 0.000 0.000 -2.982</pose></waypoint>
