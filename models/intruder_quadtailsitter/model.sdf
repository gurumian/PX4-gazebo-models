      <waypoint><time>1111.673</time><pose>-250.00 66.99 0.00 0.000 0.000 -0.524</pose></waypoint>
      <waypoint><time>1114.814</time><pose>-171.01 30.15 0.00 0.000 0.000 -0.349</pose></waypoint>
      <waypoint><time>1117.956</time><pose>-86.82 7.60 0.00 0.000 0.000 -0.175</pose></waypoint>
      <waypoint><time>1121.097</time><pose>-0.00 0.00 0.00 0.000 0.000 0.000</pose></waypoint>
    </plugin>
  </model>
