      <waypoint><time>1083.398</time><pose>-433.01 750.00 0.00 0.000 0.000 -2.094</pose></waypoint>
      <waypoint><time>1086.540</time><pose>-469.85 671.01 0.00 0.000 0.000 -1.920</pose></waypoint>
      <waypoint><time>1089.681</time><pose>-492.40 586.82 0.00 0.000 0.000 -1.745</pose></waypoint>
      <waypoint><time>1092.823</time><pose>-500.00 500.00 0.00 0.000 0.000 -1.571</pose></waypoint>
      <waypoint><time>1095.965</time><pose>-492.40 413.18 0.00 0.000 0.000 -1.396</pose></waypoint>
